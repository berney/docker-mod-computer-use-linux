#!/usr/bin/with-contenv bash

# computer-use-linux lists and focuses X11 windows with wmctrl and xprop.
# linuxserver's init-mods-package-install installs what this adds to the list.
# Alpine packages wmctrl only in edge/testing, so Alpine images go without and
# X11 window control there is limited to i3.
if command -v wmctrl >/dev/null || [ -f /sbin/apk ]; then
  exit 0
fi
echo "**** computer-use-linux: adding wmctrl to the mod package list ****"
echo "wmctrl" >>/mod-repo-packages-to-install.list
