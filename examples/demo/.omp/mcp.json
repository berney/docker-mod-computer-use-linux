{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "webtop": {
      "type": "http",
      "url": "http://127.0.0.1:5200/mcp",
      "headers": {
        "Authorization": "Bearer ${COMPUTER_USE_LINUX_MCP_TOKEN}"
      },
      "timeout": 60000
    }
  }
}
